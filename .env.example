# Environment Variables for SE-LIFE Application

# Database Configuration
# Set USE_MYSQL=True to use MySQL, or False/omit to use SQLite
USE_MYSQL=True

# Aiven MySQL Connection Details
# Get these from your Aiven service dashboard
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password-here
DB_NAME=defaultdb

# Application Secret Key
# Change this to a random secret key for production
SECRET_KEY=your-secret-key-here

# Instructions:
# 1. Copy this file to .env (do not commit .env to git!)
# 2. Replace the placeholder values with your actual Aiven credentials
# 3. For local development, you can set USE_MYSQL=False to use SQLite
